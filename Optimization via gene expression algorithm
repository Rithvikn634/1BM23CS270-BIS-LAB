import numpy as np
import random

def evaluate_expression(individual, gene_expressions):
    predicted = sum(individual[i] * gene_expressions[i] for i in range(len(gene_expressions)))
    return predicted

def gene_expression_algorithm(gene_expressions, target_activity, pop_size=50, generations=100):
    num_genes = len(gene_expressions)
    
    population = [np.random.uniform(-10, 10, num_genes) for _ in range(pop_size)]
    
    best_individual = None
    best_fitness = float('inf')
    
    for gen in range(generations):
        fitness_scores = []
        for individual in population:
            predicted = evaluate_expression(individual, gene_expressions)
            error = abs(predicted - target_activity)
            fitness_scores.append(error)
            
            if error < best_fitness:
                best_fitness = error
                best_individual = individual.copy()
        
        selected = []
        for _ in range(pop_size):
            i1, i2 = random.sample(range(pop_size), 2)
            if fitness_scores[i1] < fitness_scores[i2]:
                selected.append(population[i1].copy())
            else:
                selected.append(population[i2].copy())
        
        offspring = []
        for i in range(0, pop_size, 2):
            if i+1 < pop_size:
                parent1, parent2 = selected[i], selected[i+1]
                crossover_point = random.randint(1, num_genes-1)
                child1 = np.concatenate([parent1[:crossover_point], parent2[crossover_point:]])
                child2 = np.concatenate([parent2[:crossover_point], parent1[crossover_point:]])
                offspring.extend([child1, child2])
            else:
                offspring.append(selected[i])
        
        mutation_rate = 0.1
        for individual in offspring:
            if random.random() < mutation_rate:
                gene_idx = random.randint(0, num_genes-1)
                individual[gene_idx] += np.random.uniform(-1, 1)
        
        population = offspring
    
    return best_individual, best_fitness
print("Application: Predicting Enzyme activity from Gene Expression problem")
print("\nInput:")

# Get expression levels for each gene (up to 5 genes)
gene_expressions = []

for gene_number in range(1, 6):
    expr_level = int(input(f"Expression level of Gene-{gene_number} (0 to 10): "))
    gene_expressions.append(expr_level)

target_activity = 18.1446

print("\nRunning Gene Expression Algorithm...")
best_weights, error = gene_expression_algorithm(gene_expressions, target_activity)

predicted_activity = evaluate_expression(best_weights, gene_expressions)

print("\nOutput:")
