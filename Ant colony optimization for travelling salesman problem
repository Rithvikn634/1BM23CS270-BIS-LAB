import numpy as np
import random

class AntColonyVRP:
    def __init__(self, distance_matrix, num_vehicles, vehicle_capacity, num_customers, customer_demands):
        self.distance_matrix = np.array(distance_matrix)
        self.num_vehicles = num_vehicles
        self.vehicle_capacity = vehicle_capacity
        self.num_customers = num_customers
        self.customer_demands = customer_demands
        self.num_nodes = len(distance_matrix)
        
        # ACO parameters
        self.num_ants = 10
        self.num_iterations = 100
        self.alpha = 1.0  # pheromone importance
        self.beta = 2.0   # distance importance
        self.evaporation_rate = 0.5
        self.Q = 100
        
        # Initialize pheromone matrix
        self.pheromone = np.ones((self.num_nodes, self.num_nodes))
        
    def calculate_route_distance(self, route):
        distance = 0
        for i in range(len(route) - 1):
            distance += self.distance_matrix[route[i]][route[i + 1]]
        return distance
    
    def construct_solution(self):
        """Construct a solution using ant colony approach"""
        unvisited = list(range(1, self.num_customers + 1))  # Customer nodes (excluding depot 0)
        routes = []
        
        for vehicle in range(self.num_vehicles):
            route = [0]  # Start at depot
            current_capacity = 0
            current_node = 0
            
            while unvisited and current_capacity < self.vehicle_capacity:
                # Calculate probabilities for next node
                probabilities = []
                valid_nodes = []
                
                for node in unvisited:
                    if current_capacity + self.customer_demands[node - 1] <= self.vehicle_capacity:
                        pheromone = self.pheromone[current_node][node] ** self.alpha
                        distance = (1.0 / self.distance_matrix[current_node][node]) ** self.beta
                        probabilities.append(pheromone * distance)
                        valid_nodes.append(node)
                
                if not valid_nodes:
                    break
                
                # Normalize probabilities
                total = sum(probabilities)
                probabilities = [p / total for p in probabilities]
                
                # Select next node
                next_node = random.choices(valid_nodes, weights=probabilities)[0]
                route.append(next_node)
                current_capacity += self.customer_demands[next_node - 1]
                current_node = next_node
                unvisited.remove(next_node)
            
            route.append(0)  # Return to depot
            routes.append(route)
        
        return routes
    
    def update_pheromones(self, all_routes, all_distances):
        """Update pheromone levels"""
        # Evaporation
        self.pheromone *= (1 - self.evaporation_rate)
        
        # Add new pheromones
        for routes, total_distance in zip(all_routes, all_distances):
            pheromone_deposit = self.Q / total_distance
            for route in routes:
                for i in range(len(route) - 1):
                    self.pheromone[route[i]][route[i + 1]] += pheromone_deposit
                    self.pheromone[route[i + 1]][route[i]] += pheromone_deposit
    
    def solve(self):
        """Run ACO algorithm"""
        best_routes = None
        best_distance = float('inf')
        
        for iteration in range(self.num_iterations):
            all_routes = []
            all_distances = []
            
            for ant in range(self.num_ants):
                routes = self.construct_solution()
                total_distance = sum(self.calculate_route_distance(route) for route in routes)
                
                all_routes.append(routes)
                all_distances.append(total_distance)
                
                if total_distance < best_distance:
                    best_distance = total_distance
                    best_routes = routes
            
            self.update_pheromones(all_routes, all_distances)
        
        return best_routes, best_distance


