import random
import math

def distance(city1, city2):
    return math.sqrt((city1[0] - city2[0])**2 + (city1[1] - city2[1])**2)

def route_distance(route, cities):
    dist = 0
    for i in range(len(route)):
        dist += distance(cities[route[i]], cities[route[(i + 1) % len(route)]])
    return round(dist, 2)

def create_population(cities, pop_size):
    population = []
    for _ in range(pop_size):
        route = list(cities.keys())
        random.shuffle(route)
        population.append(route)
    return population

def selection(population, cities):
    ranked = sorted(population, key=lambda r: route_distance(r, cities))
    return ranked[:len(ranked)//2]

def crossover(parent1, parent2):
    start, end = sorted(random.sample(range(len(parent1)), 2))
    child = [None]*len(parent1)
    child[start:end] = parent1[start:end]
    ptr = 0
    for gene in parent2:
        if gene not in child:
            while child[ptr] is not None:
                ptr += 1
            child[ptr] = gene
    return child

def mutate(route, mutation_rate):
    for i in range(len(route)):
        if random.random() < mutation_rate:
            j = random.randint(0, len(route)-1)
            route[i], route[j] = route[j], route[i]
    return route

def genetic_algorithm(cities, pop_size=6, generations=5, mutation_rate=0.3):
    population = create_population(cities, pop_size)

    for g in range(1, generations+1):
        print(f"\n--- Generation {g} ---")
        for i, route in enumerate(population):
            print(f"Route {i+1}: {route}, Distance = {route_distance(route, cities)}")

        selected = selection(population, cities)
        children = []

        while len(children) < pop_size:
            p1, p2 = random.sample(selected, 2)
            child = crossover(p1, p2)
            child = mutate(child, mutation_rate)
            children.append(child)

        population = children

    best_route = min(population, key=lambda r: route_distance(r, cities))
    print("\n--- Best Solution ---")
    print(f"Best Route: {best_route}")
    print(f"Shortest Distance: {route_distance(best_route, cities)}")

cities = {
    'A': (0, 0),
    'B': (2, 4),
    'C': (4, 3),
    'D': (1, 1),
    'E': (3, 0)
}

genetic_algorithm(cities)
