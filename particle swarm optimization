import numpy as np

# Rastrigin function
def rastrigin(x):
    n = len(x)
    return 10 * n + sum(xi**2 - 10 * np.cos(2 * np.pi * xi) for xi in x)

# PSO Algorithm
def pso(func, dimensions, num_particles, max_iter, x_min, x_max, w, c1, c2):
    # Initialize particles
    particles = np.random.uniform(x_min, x_max, (num_particles, dimensions))
    velocities = np.random.uniform(-1, 1, (num_particles, dimensions))
    
    # Initialize personal best
    personal_best_positions = particles.copy()
    personal_best_fitness = np.array([func(p) for p in particles])
    
    # Initialize global best
    global_best_idx = np.argmin(personal_best_fitness)
    global_best_position = personal_best_positions[global_best_idx].copy()
    global_best_fitness = personal_best_fitness[global_best_idx]
    
    # Optimization loop
    for iteration in range(1, max_iter + 1):
        for i in range(num_particles):
            # Update velocity
            r1 = np.random.random(dimensions)
            r2 = np.random.random(dimensions)
            
            cognitive = c1 * r1 * (personal_best_positions[i] - particles[i])
            social = c2 * r2 * (global_best_position - particles[i])
            velocities[i] = w * velocities[i] + cognitive + social
            
            # Update position
            particles[i] = particles[i] + velocities[i]
            
            # Clip to bounds
            particles[i] = np.clip(particles[i], x_min, x_max)
            
            # Evaluate fitness
            fitness = func(particles[i])
            
            # Update personal best
            if fitness < personal_best_fitness[i]:
                personal_best_fitness[i] = fitness
                personal_best_positions[i] = particles[i].copy()
            
            # Update global best
            if fitness < global_best_fitness:
                global_best_fitness = fitness
                global_best_position = particles[i].copy()
        
        # Print progress (matching your output format)
        if iteration % (max_iter // 10) == 0 or iteration == 1:
            print(f"Iteration {iteration}/{max_iter} - Best fitness: {global_best_fitness:.6f}")
    
    return global_best_position, global_best_fitness

